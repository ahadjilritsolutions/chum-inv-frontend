# ════════════════════════════════════════════════════════════════════════════
# chum-inv-frontend — BUILD-TIME configuration.
#
# ⚠ READ AT BUILD TIME, NOT AT RUNTIME. Next inlines `basePath` and every
# NEXT_PUBLIC_* into the client bundle, so no runtime flag can change them
# afterwards. Applying a change here is
#     docker compose up -d --build inv-frontend
# never a plain restart. This file must EXIST before `docker compose build`:
# build without one and you get an UNPREFIXED image that starts happily and
# then 404s every asset behind nginx.
# ════════════════════════════════════════════════════════════════════════════

# ── Where the backend lives, from the BROWSER's point of view ───────────────
# Local dev: the backend on 4003, unprefixed.
# Behind nginx: the public origin PLUS the API prefix, e.g.
#     https://sih-test.chumustapha.local/inventaire-backend
# It must agree with the backend's API_BASE_PATH or every call 404s.
NEXT_PUBLIC_API_URL=http://localhost:4003

# ── The path this app is served under ───────────────────────────────────────
# Empty locally. `/inventaire` behind nginx — and it must match the nginx
# location block exactly. Emptying it reproduces the local, un-prefixed setup.
NEXT_PUBLIC_BASE_PATH=

# ── External help portal, linked above the logout row in the sidebar ────────
NEXT_PUBLIC_PORTAL_URL=https://192.168.254.10
