# ════════════════════════════════════════════════════════════════════════════
# chum-inv-frontend — modèle à copier en .env SUR LE SERVEUR DE PRODUCTION
#     sih (192.168.254.18) : /opt/inventaire/chum-inv-frontend/.env
#
# ⚠ LU AU BUILD, PAS AU DÉMARRAGE.
#
# Next fige `basePath` et chaque NEXT_PUBLIC_* DANS LE BUNDLE au
# `docker compose build`. Aucun réglage au démarrage ne peut les changer
# ensuite. Appliquer une modification, c'est donc :
#     docker compose up -d --build inv-frontend
# jamais un simple `restart`.
#
# Ce fichier doit EXISTER avant le build : dockerfile.prod contient
# `RUN test -f .env` pour que son absence fasse échouer la construction plutôt
# que produire une image qui démarre très bien et renvoie 404 sur chaque
# ressource derrière nginx.
# ════════════════════════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3003
TZ=Africa/Algiers

# ── Où est l'API, vue par le NAVIGATEUR ─────────────────────────────────────
# Relative : le navigateur tape la même origine
# (https://sih.chumustapha.local) et nginx proxifie /inv-api/* vers le backend.
#
# Une URL absolue vers 127.0.0.1 marcherait sur le serveur et sur AUCUN poste :
# c'est le navigateur qui fait l'appel, pas le conteneur.
#
# Doit s'accorder avec API_BASE_PATH du backend, sinon chaque appel tombe en 404.
NEXT_PUBLIC_API_URL=/inv-api

# ── Préfixe public sous lequel nginx sert l'application ─────────────────────
# Doit correspondre EXACTEMENT au bloc `location /inv` de nginx.
NEXT_PUBLIC_BASE_PATH=/inv

# ── Retour vers le portail SIH (« Aide et FAQ » de la barre latérale) ───────
NEXT_PUBLIC_PORTAL_URL=https://sih.chumustapha.local
